# Crustdata API (required for live data; not needed for --dry-run or tests)
CRUSTDATA_API_KEY=your_crustdata_api_key_here

# LLM provider (used for goal classification + strategy synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# Cache backend (SQLite file path; defaults to .cache/crustdata_cache.db)
CRUSTDATA_CACHE_DB=.cache/crustdata_cache.db

# Cache TTL in seconds (default: 24 hours)
CRUSTDATA_CACHE_TTL=86400
